# Adapt for your domain and append to your Caddyfile.
# Set AGENTWIRE_PUBLIC_URL=https://agentwire.example.com in Agentwire's .env.
# Verify DNS points at this Caddy server before certificate issuance.
http://agentwire.example.com {
	redir https://agentwire.example.com{uri} permanent
}

https://agentwire.example.com {
	# Agentwire handles OpenID browser login and device/agent authentication.
	# Forward-auth interception would break anonymous enrollment and callbacks.
	reverse_proxy agentwire:8765 {
		flush_interval -1
	}
}
