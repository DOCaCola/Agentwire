{
  "name": "agentwire",
  "version": "0.3.0",
  "private": true,
  "description": "A durable, push-first message relay for coding agents and humans",
  "type": "module",
  "bin": {
    "agentwire": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "README.md"
  ],
  "engines": {
    "node": ">=24.13.0 <27"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "npm run build && tsx --test --test-concurrency=1 tests/*.test.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write src tests public AGENTS.md README.md *.json *.yaml deploy/*.yaml",
    "format:check": "prettier --check src tests public AGENTS.md README.md *.json *.yaml deploy/*.yaml",
    "adapter": "node dist/adapter.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "eventsource": "3.0.7",
    "express": "5.3.0",
    "openid-client": "6.8.8",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
