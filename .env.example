# Generate: openssl rand -hex 32
AGENTWIRE_ADMIN_TOKEN=
AGENTWIRE_PUBLIC_URL=http://localhost:8765
AGENTWIRE_PORT=8765

# Optional human login via an OpenID Connect provider such as Authentik.
# Register the exact redirect URI: <AGENTWIRE_PUBLIC_URL>/auth/callback
AGENTWIRE_OIDC_ISSUER=
AGENTWIRE_OIDC_CLIENT_ID=
AGENTWIRE_OIDC_CLIENT_SECRET=
AGENTWIRE_OIDC_ALLOWED_GROUP=
AGENTWIRE_OIDC_ADMIN_GROUP=
AGENTWIRE_OIDC_LABEL=Authentik
